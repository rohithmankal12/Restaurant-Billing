{
  "name": "restaurant-billing",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run build && node electron/launch.cjs",
    "dev": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "test": "node --test test/*.test.cjs",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "smoke": "node electron/launch.cjs --smoke"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "rxjs": "^7.8.2",
    "sql.js": "^1.13.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.3"
  },
  "build": {
    "appId": "local.restaurant.billing",
    "productName": "Counter Billing",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "directories": {
      "output": "release"
    }
  }
}
